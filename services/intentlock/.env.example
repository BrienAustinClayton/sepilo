# config, wave 1: Keep 'sandbox'.
PAYPAL_ENV=sandbox
# secret, wave 1: developer.paypal.com > Apps & Credentials > Sandbox > your app > Client ID. Enable 'Vault' / save payment methods on the app.
PAYPAL_CLIENT_ID=__FILL_ME__
# secret, wave 1: Same app page > Sec,
# secret, wave 4: Same app > Webhooks > Add webhook to <Render API URL>/webhooks/paypal (events: PAYMENT.AUTHORIZATION.VOIDED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED) > copy Webhook ID.
PAYPAL_WEBHOOK_ID=__FILL_ME__
# config, wave 1: developer.paypal.com > Testing Tools > Sandbox Accounts > Personal account email (used to approve vault once).
PAYPAL_SANDBOX_BUYER_EMAIL=__FILL_ME__
# config, wave 2: Groq (free) text model, OpenAI-compatible endpoint. Groq default; or Gemini https://generativelanguage.googleapis.com/v1beta/openai/ ; OpenRouter https://openrouter.ai/api/v1 ; local Ollama http://localhost:11434/v1
LLM_FAST_BASE_URL=https://api.groq.com/openai/v1
# secret, wave 2: Free key from the chosen provider: console.groq.com/keys | aistudio.google.com/apikey | openrouter.ai/keys (Ollama: any string).
LLM_FAST_API_KEY=__FILL_ME__
# config, wave 2: Best free Groq model (JSON + tool calling). Writes text: reasons, graph answers.
LLM_FAST_MODEL=openai/gpt-oss-120b
# config, wave 2: Groq prompt-injection classifier, extra signal for scan_injection.
LLM_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# config, wave 2: Jev (TypeSafe System One). NOT OpenAI-compatible: POST /v1/systemone.
LLM_SMART_BASE_URL=https://api.typesafe.ai
# secret, wave 2: Jev key from console.typesafe.ai > API Keys ($5 credit).
LLM_SMART_API_KEY=__FILL_ME__
# config, wave 2: jev-latest (or pin a version like jev-1.13.0 for the demo).
LLM_SMART_MODEL=jev-latest
# config, wave 2: Total Jev credit. Guard stops smart calls at LLM_SMART_RESERVE_USD left and falls back to fast.
LLM_SMART_BUDGET_USD=5
# config, wave 2: Credit kept for the demo + judging.
LLM_SMART_RESERVE_USD=1
# config, wave 2: Jev price per 1M input tokens (USD), Oct 2026.
LLM_SMART_PRICE_IN_PER_MTOK=0.042
# config, wave 2: Jev output tokens are free.
LLM_SMART_PRICE_OUT_PER_MTOK=0
# secret, wave 1: trychannel3.com/developers > sign up > API key. Redeem promo PAYPAL-HACKATHON-2026 (20,000 credits).
CHANNEL3_API_KEY=__FILL_ME__
# config: live Channel3 calls per UTC day from the API (default 300); searches stop at 80%.
CHANNEL3_DAILY_LIMIT=300
# secret, wave 1: Local default ok. For Render: dashboard > Postgres > Connect > External URL (swap scheme to postgresql+psycopg://).
DATABASE_URL=__FILL_ME__
# secret, wave 3: dashboard.render.com > Account Settings > API Keys (needed to start Render Workflow runs).
RENDER_API_KEY=__FILL_ME__
# config, wave 3: Render dashboard > Workflows > your workflow slug, after P1-T08 deploys it.
RENDER_WORKFLOW_SLUG=__FILL_ME__
# secret, wave 4: console.neo4j.io > AuraDB Free > instance > Connection URI (neo4j+s://...).
NEO4J_URI=__FILL_ME__
# config, wave 4: Usually 'neo4j'.
NEO4J_USERNAME=neo4j
# secret, wave 4: Shown once when the AuraDB instance is created (downloaded credentials file).
NEO4J_PASSWORD=__FILL_ME__
# generated, wave 3: Run `creds.py genkeys`.
INTENTLOCK_PROOF_PRIVATE_KEY=__FILL_ME__
# generated, wave 3: Run `creds.py genkeys`.
INTENTLOCK_PROOF_PUBLIC_KEY=__FILL_ME__
# generated, wave 2: Run `creds.py genkeys`.
INTENTLOCK_WALLET_PRIVATE_KEY=__FILL_ME__
# config, wave 1: Web app origin for CORS. Render web URL after deploy.
WEB_ORIGIN=http://localhost:3000
# config, wave 1: API public URL. Render API URL after deploy (used for PayPal return URLs).
PUBLIC_BASE_URL=http://localhost:8000
# secret, wave 1: Random string used to hash sign-in codes. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=__FILL_ME__
# secret, wave 1: resend.com > API Keys > Create API key (Sending access). Without a verified domain Resend only delivers to your own account email.
RESEND_API_KEY=__FILL_ME__
# config, wave 1: Sender address. onboarding@resend.dev for testing, or support@sepilo.space.
RESEND_FROM="Sepilo <support@sepilo.space>"
# secret, wave 1: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web). Redirect URIs: http://localhost:3000/api/auth/google/callback and <web URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=__FILL_ME__
# secret, wave 1: Same OAuth client > Client secret.
GOOGLE_CLIENT_SECRET=__FILL_ME__
# config, wave 3: Hosted shopping agent base URL (apps/agent). Render: https://intentlock-agent.onrender.com
AGENT_SERVICE_URL=http://127.0.0.1:8808
# secret, wave 3: Shared secret between API and hosted agent. Any long random string; same value on the agent service.
AGENT_RUN_SECRET=__FILL_ME__
# secret: Operator key for admin-only routes (header X-Admin-Key). Leave unset to keep them closed.
ADMIN_API_KEY=

DISPUTE_MANAGER_EMAILS=
FIRECRAWL_API_KEY=__FILL_ME__
